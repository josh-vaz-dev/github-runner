# GitHub Configuration
# For organization runners: Set GITHUB_OWNER to your organization name and leave GITHUB_REPOSITORY empty
# For repository runners: Set both GITHUB_OWNER and GITHUB_REPOSITORY

GITHUB_OWNER=your-github-username-or-org
GITHUB_REPOSITORY=your-repo-name
GITHUB_TOKEN=your-github-personal-access-token

# Runner Configuration
RUNNER_NAME=proxmox-runner-1
RUNNER_WORKDIR=/home/runner/_work
RUNNER_LABELS=self-hosted,proxmox,docker,linux
RUNNER_GROUP=Default

# Optional: Deployment Targets (non-sensitive configuration)
# Use GitHub Secrets for SSH keys and sensitive data
# PI5_HOST=192.168.1.100
# PI5_USER=pi
# PROXMOX_HOST=192.168.1.50
# PROXMOX_USER=root